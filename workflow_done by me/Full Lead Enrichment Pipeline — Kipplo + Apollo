        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst newLeads = staticData.masterLeads || [];\nstaticData.masterLeads = []; // ← clear immediately after reading\n\n// ── Canonical column order ────────────────────────────────────────────────────\nconst COLUMNS = [\n  'company_linkedin_url','company_name','company_id','domain',\n  'industry','company_size','company_location','data_source_company',\n  'person_name','title','seniority','email','all_emails',\n  'phone','person_linkedin_url','person_location',\n  'data_source_person','enriched_at','dedup_key','kipplo_raw'\n];\n\n// ── Helper: strip BOM, enforce column order ───────────────────────────────────\nfunction cleanRow(raw) {\n  const cleaned = {};\n  for (const [key, val] of Object.entries(raw)) {\n    const clean_key = key.replace(/[\\ufeff\\ufffe]/g, '').trim();\n    if (cleaned[clean_key] && !val) continue;\n    cleaned[clean_key] = val || '';\n  }\n  const out = {};\n  for (const col of COLUMNS) { out[col] = cleaned[col] || ''; }\n  return out;\n}\n\n// ── Read existing rows from Parse Old CSV (predecessor node) ──────────────────\nconst existingRows = $input.all()\n  .map(item => cleanRow(item.json))\n  .filter(row => row.company_name); // skip _empty sentinel rows\n\nconsole.log('Existing rows from Drive:', existingRows.length, '| New leads:', newLeads.length);\n\nif (newLeads.length === 0 && existingRows.length === 0) {\n  return [{ json: { status: 'no_leads' } }];\n}\n\n// ── Clean new leads ───────────────────────────────────────────────────────────\nconst cleanedNew = newLeads.map(r => cleanRow(r));\n\n// ── Deduplicate: new leads take priority over existing ────────────────────────\nconst newKeys = new Set(cleanedNew.map(r => r.dedup_key).filter(Boolean));\n\nconst merged = [\n  ...existingRows.filter(r => !r.dedup_key || !newKeys.has(r.dedup_key)),\n  ...cleanedNew\n];\n\nconsole.log('Merged total:', merged.length);\nreturn merged.map(r => ({ json: r }));"
