        "jsCode": "function parseCSV(csvText) {\n  if (!csvText || !csvText.trim()) return [];\n  const text = csvText.replace(/^\\ufeff/, '').trim();\n  const lines = text.split('\\n').map(l => l.replace(/\\r$/, ''));\n  if (lines.length < 2) return [];\n\n  const headers = splitCSVLine(lines[0]).map(h => h.trim());\n\n  const rows = [];\n  for (let i = 1; i < lines.length; i++) {\n    const line = lines[i].trim();\n    if (!line) continue;\n    const values = splitCSVLine(line);\n    const row = {};\n    headers.forEach((h, idx) => { row[h] = (values[idx] || '').trim(); });\n    if (row.dedup_key || row.company_name) rows.push(row);\n  }\n  return rows;\n}\n\nfunction splitCSVLine(line) {\n  const values = [];\n  let current = '', inQuotes = false;\n  for (let i = 0; i < line.length; i++) {\n    const ch = line[i];\n    if (ch === '\"') { inQuotes = !inQuotes; }\n    else if (ch === ',' && !inQuotes) { values.push(current); current = ''; }\n    else { current += ch; }\n  }\n  values.push(current);\n  return values;\n}\n\nlet rows = [];\ntry {\n  const inputItem = $input.first();\n  const binary = inputItem?.binary || {};\n  const binaryKey = Object.keys(binary)[0];\n  const binaryEntry = binary[binaryKey];\n\n  if (binaryEntry?.data) {\n    const csvText = Buffer.from(binaryEntry.data, 'base64').toString('utf-8');\n    rows = parseCSV(csvText);\n    console.log('Parsed rows:', rows.length);\n  } else {\n    console.log('Empty file — starting fresh');\n  }\n} catch (e) {\n  console.log('CSV parse error:', e.message);\n}\n\nif (rows.length === 0) return [{ json: { _empty: true } }];\nreturn rows.map(r => ({ json: r }));"
