      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\n// ── Initialise ────────────────────────────────────────────────────────────────\nif (!staticData.masterLeads) staticData.masterLeads = [];\nif (!staticData.batchCount)  staticData.batchCount  = 0;\n\n// ── Increment batch counter every loop run ────────────────────────────────────\nstaticData.batchCount += 1;\n\n// ── Dedup set from already-accumulated leads ───────────────────────────────────\nconst seen = new Set(\n  staticData.masterLeads.map(r => r.dedup_key).filter(Boolean)\n);\n\nconst items = $input.all();\n\nfor (const item of items) {\n  const d = item.json;\n\n  if (!d.company_linkedin_url || !d.company_name || !d.person_name) continue;\n  if (d.reason) continue;\n\n  const key = d.email?.trim() ||\n              d.linkedin_url?.trim() ||\n              (d.person_name + \"_\" + d.company_name)\n              .toLowerCase().replace(/\\s+/g, \"_\");\n\n  if (!key || seen.has(key)) continue;\n  seen.add(key);\n\n  staticData.masterLeads.push({\n    company_linkedin_url: d.company_linkedin_url || \"\",\n    company_name:         d.company_name         || \"\",\n    company_id:           d.company_id           || \"\",\n    domain:               d.domain               || \"\",\n    industry:             d.company_industry     || \"\",\n    company_size:         d.company_size         || \"\",\n    company_location:     d.company_location     || \"\",\n    data_source_company:  d.data_source_company  || \"\",\n    person_name:          d.person_name          || \"\",\n    title:                d.title                || \"\",\n    seniority:            d.seniority            || \"\",\n    email:                d.email                || \"\",\n    all_emails:           (d.all_emails || \"\").substring(0, 500),\n    phone:                d.phone                || \"\",\n    person_linkedin_url:  d.linkedin_url         || \"\",\n    person_location:      d.location             || \"\",\n    data_source_person:   d.data_source_person   || \"\",\n    enriched_at:          d.enriched_at          || \"\",\n    dedup_key:            key,\n    kipplo_raw:           d.kipplo_raw || \"\"\n  });\n}\n\nconst isLastBatch  = $node[\"Loop Over Items\"].context.noItemsLeft;\n// ── Checkpoint every 10 loops OR on last batch ────────────────────────────────\nconst isCheckpoint = (staticData.batchCount % 10 === 0) || isLastBatch;\n\n// Reset counter after last batch so next workflow run starts from 0\nif (isLastBatch) staticData.batchCount = 0;\n\nconsole.log(\n  `Batch #${staticData.batchCount} | Accumulated: ${staticData.masterLeads.length}` +\n  ` | Checkpoint: ${isCheckpoint} | Last: ${isLastBatch}`\n);\n\nreturn [{ json: {\n  status:            'accumulated',\n  count:             staticData.masterLeads.length,\n  is_last_batch:     isLastBatch,\n  should_checkpoint: isCheckpoint\n}}];"
