):0, ctor=nUO>0?(nUC/nUO*100):0;\n\nvar m = {\n  delivered:nDel, hardBounces:nHB, softBounces:nSB, dropped:nDrop, unsubscribes:nUnsub,\n  totalOpens:nTO, uniqueOpens:nUO, totalClicks:nTC, uniqueClicks:nUC,\n  botOpens:nBO, botClicks:nBC,\n  openRate:Math.round(openRate*100)/100, ctr:Math.round(ctr*100)/100, ctor:Math.round(ctor*100)/100,\n  postDeliveryBounces:Object.keys(postDelBounce).length,\n  deferredThenBounced:0\n};\n\n// Count deferred-then-bounced\nvar bk = Object.keys(bouncedKeys);\nfor (var i = 0; i < bk.length; i++) {\n  if (deferredKeys[bk[i]] && !deliveredKeys[bk[i]]) m.deferredThenBounced++;\n}\n\n// Build detail arrays for Excel sheets\nfunction getEvt(rkey, evtName) {\n  var evts = eventsByKey[rkey] || [];\n  for (var i = 0; i < evts.length; i++) if (evts[i].event === evtName) return evts[i];\n  return null;\n}\nfunction getSid(evt) {\n  try { return JSON.parse(evt.unique_args||'{}').singlesend_id||''; } catch(e){ return ''; }\n}\nfunction fmtDT(d) { if(!d) return ''; try{return d.toISOString().replace('T',' ').substring(0,19);}catch(e){return '';} }\n\nvar delArr=[], hbArr=[], sbArr=[], unsubArr=[], dropArr=[];\nvar cdk=Object.keys(cleanDelivered);\nfor(var i=0;i<cdk.length;i++){var e=getEvt(cdk[i],'delivered');if(e)delArr.push({email:e.email,message_id:e.message_id,time:e.processed,subject:e.subject,from:e.from,singlesend_id:getSid(e)});}\nvar bkk=Object.keys(bouncedKeys);\nfor(var i=0;i<bkk.length;i++){var e=getEvt(bkk[i],'bounce');if(e)hbArr.push({email:e.email,message_id:e.message_id,time:e.processed,type:e.type||'bounce',reason:e.reason||''});}\nvar sbk=Object.keys(softBounce);\nfor(var i=0;i<sbk.length;i++){var e=getEvt(sbk[i],'deferred');if(e)sbArr.push({email:e.email,message_id:e.message_id,time:e.processed,reason:e.reason||''});}\nvar usk=Object.keys(unsubKeys);\nfor(var i=0;i<usk.length;i++){var e=getEvt(usk[i],'unsubscribe')||getEvt(usk[i],'group_unsubscribe');if(e)unsubArr.push({email:e.email,message_id:e.message_id,time:e.processed,eve