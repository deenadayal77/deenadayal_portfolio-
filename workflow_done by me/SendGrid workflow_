        "jsCode": "// ============================================================\n// ANALYZE & CLASSIFY EVENTS + BUILD EXCEL REPORT DATA\n// ============================================================\nvar csvContent = $input.first().json.csvContent;\nvar campaignName = $input.first().json.campaignName;\nvar dateRange = $input.first().json.dateRange;\nvar singlesendIds = $input.first().json.singlesendIds;\nvar reportFileName = $input.first().json.reportFileName;\nvar csvFileName = $input.first().json.csvFileName;\n\n// Parse CSV\nvar lines = csvContent.split('\\n');\nvar headers = lines[0].split(',');\n\nfunction parseCSVLine(line) {\n  var result = [], current = '', inQ = false;\n  for (var i = 0; i < line.length; i++) {\n    var c = line.charAt(i);\n    if (inQ) {\n      if (c === '\"' && i+1 < line.length && line.charAt(i+1) === '\"') { current += '\"'; i++; }\n      else if (c === '\"') inQ = false;\n      else current += c;\n    } else {\n      if (c === '\"') inQ = true;\n      else if (c === ',') { result.push(current); current = ''; }\n      else current += c;\n    }\n  }\n  result.push(current);\n  return result;\n}\n\nvar rows = [];\nfor (var i = 1; i < lines.length; i++) {\n  if (!lines[i].trim()) continue;\n  var vals = parseCSVLine(lines[i]);\n  var row = {};\n  for (var h = 0; h < headers.length; h++) row[headers[h]] = vals[h] || '';\n  rows.push(row);\n}\n\n// Build delivery times & events by recipient key\nvar BOT_THRESHOLD = 60;\nvar deliveryTimes = {};\nvar eventsByKey = {};\n\nfunction parseTS(s) {\n  if (!s) return null;\n  try {\n    var d = new Date(s);\n    if (!isNaN(d.getTime())) return d;\n  } catch(e) {}\n  return null;\n}\n\nfunction fmtDiff(sec) {\n  var s = Math.abs(sec);\n  if (s < 60) return Math.round(s) + 's';\n  if (s < 3600) return (s/60).toFixed(1) + 'm';\n  return (s/3600).toFixed(1) + 'h';\n}\n\nfor (var i = 0; i < rows.length; i++) {\n  var row = rows[i];\n  var email = (row.email||'').trim().toLowerCase();\n  var msgId = (row.message_id||'').trim();\n  var event = (row.event||'').trim().toLowerCase();\n  var rkey = email + '|' + msgId;\n  var ts = parseTS(row.processed);\n  if (!eventsByKey[rkey]) eventsByKey[rkey] = [];\n  eventsByKey[rkey].push({ email:email, message_id:msgId, event:event, ts:ts, processed:row.processed, subject:row.subject, from:row.from, reason:row.reason, url:row.url, type:row.type, unique_args:row.unique_args, rkey:rkey });\n  if (event === 'delivered' && ts) {\n    if (!deliveryTimes[rkey] || ts < deliveryTimes[rkey]) deliveryTimes[rkey] = ts;\n  }\n}\n\n// Classify recipients\nvar deliveredKeys={}, bouncedKeys={}, deferredKeys={}, droppedKeys={}, unsubKeys={};\nvar rkeys = Object.keys(eventsByKey);\nfor (var i = 0; i < rkeys.length; i++) {\n  var rk = rkeys[i];\n  var evts = eventsByKey[rk];\n  var types = {};\n  for (var j = 0; j < evts.length; j++) types[evts[j].event] = true;\n  if (types['delivered']) deliveredKeys[rk] = true;\n  if (types['bounce']) bouncedKeys[rk] = true;\n  if (types['deferred']) deferredKeys[rk] = true;\n  if (types['dropped'] || types['drop']) droppedKeys[rk] = true;\n  if (types['unsubscribe'] || types['group_unsubscribe']) unsubKeys[rk] = true;\n}\n\nvar postDelBounce = {}, cleanDelivered = {}, softBounce = {};\nvar dk = Object.keys(deliveredKeys);\nfor (var i = 0; i < dk.length; i++) {\n  if (bouncedKeys[dk[i]]) postDelBounce[dk[i]] = true;\n  else cleanDelivered[dk[i]] = true;\n}\nvar defk = Object.keys(deferredKeys);\nfor (var i = 0; i < defk.length; i++) {\n  if (!deliveredKeys[defk[i]] && !bouncedKeys[defk[i]]) softBounce[defk[i]] = true;\n}\n\n// Opens & Clicks\nvar humanOpens=[], botOpensU={}, humanOpensU={}, humanClicks=[], botClicksU={}, humanClicksU={};\nfor (var i = 0; i < rows.length; i++) {\n  var row = rows[i];\n  var email = (row.email||'').trim().toLowerCase();\n  var msgId = (row.message_id||'').trim();\n  var event = (row.event||'').trim().toLowerCase();\n  var rkey = email + '|' + msgId;\n  var ts = parseTS(row.p