        "jsCode": "// ============================================================\n// GROUP BY CAMPAIGN PREFIX & BUILD CSVs\n// ============================================================\nvar rows = $input.first().json.rows;\nvar dateRangeLabel = $input.first().json.dateRangeLabel;\n\nif (!rows || rows.length === 0) {\n  return [{ json: { campaignGroup: 'empty', csvContent: '', rowCount: 0, singlesendIds: [] } }];\n}\n\nvar CSV_HEADERS = ['processed','message_id','event','api_key_id','recv_message_id','credential_id','subject','from','email','asm_group_id','template_id','originating_ip','reason','outbound_ip','outbound_ip_type','mx','attempt','url','user_agent','type','is_unique','username','categories','marketing_campaign_id','marketing_campaign_name','marketing_campaign_split_id','marketing_campaign_version','unique_args'];\nvar headerLine = CSV_HEADERS.join(',');\n\nfunction csvEscape(val) {\n  if (val === null || val === undefined) return '';\n  var str = String(val);\n  if (str.indexOf(',')>=0 || str.indexOf('\"')>=0 || str.indexOf('\\n')>=0) return '\"'+str.replace(/\"/g,'\"\"')+'\"';\n  return str;\n}\n\n// Group rows by singlesend_id\nvar byId = {};\nfor (var i = 0; i < rows.length; i++) {\n  var row = rows[i];\n  var sid = '__no_singlesend_id__', sname = 'no_campaign';\n  try {\n    var ua = row.unique_args;\n    if (typeof ua === 'string' && ua.charAt(0) === '{') {\n      var p = JSON.parse(ua);\n      if (p.singlesend_id) sid = p.singlesend_id;\n      if (p.singlesend_name) sname = p.singlesend_name;\n    }\n  } catch(e) {}\n  if (!byId[sid]) byId[sid] = { name: sname, rows: [] };\n  if (sname !== 'no_campaign') byId[sid].name = sname;\n  byId[sid].rows.push(row);\n}\n\n// Group singlesend_ids by campaign prefix\nvar campaignGroups = {};\nvar sids = Object.keys(byId);\nfor (var j = 0; j < sids.length; j++) {\n  var sid = sids[j];\n  var data = byId[sid];\n  var name = data.name;\n  var prefix = 'Uncategorized';\n  var dashIdx = name.indexOf(' - ');\n  if (dashIdx > 0) prefix = name.substring(0, dashIdx).trim();\n  else if (name !== 'no_campaign') prefix = name.split(' ')[0];\n  \n  if (!campaignGroups[prefix]) campaignGroups[prefix] = { sids: [], rows: [], sampleName: name };\n  campaignGroups[prefix].sids.push(sid);\n  for (var k = 0; k < data.rows.length; k++) campaignGroups[prefix].rows.push(data.rows[k]);\n  if (name.length > campaignGroups[prefix].sampleName.length) campaignGroups[prefix].sampleName = name;\n}\n\n// Build output per campaign group\nvar result = [];\nvar prefixes = Object.keys(campaignGroups);\nfor (var g = 0; g < prefixes.length; g++) {\n  var pre = prefixes[g];\n  var grp = campaignGroups[pre];\n  var csvLines = [headerLine];\n  for (var r = 0; r < grp.rows.length; r++) {\n    var line = [];\n    for (var c = 0; c < CSV_HEADERS.length; c++) line.push(csvEscape(grp.rows[r][CSV_HEADERS[c]]));\n    csvLines.push(line.join(','));\n  }\n  \n  var campaignName = grp.sampleName;\n  var nm = campaignName.match(/^\\d+\\s*-\\s*(.+?)(?:\\s*-\\s*Camp|\\s*-\\s*\\d|\\s*-\\s*L\\d|$)/);\n  if (nm) campaignName = nm[1].trim();\n  var safeName = campaignName.replace(/[^a-z0-9 _-]/gi,'').replace(/\\s+/g,'_').substring(0,50);\n  \n  result.push({\n    json: {\n      campaignPrefix: pre,\n      campaignName: campaignName,\n      dateRange: dateRangeLabel,\n      singlesendIds: grp.sids,\n      singlesendCount: grp.sids.length,\n      csvContent: csvLines.join('\\n'),\n      rowCount: grp.rows.length,\n      csvFileName: safeName+'_'+pre+'.csv',\n      reportFileName: safeName+'_'+pre+'_report.xlsx'\n    }\n  });\n}\nreturn result;"
