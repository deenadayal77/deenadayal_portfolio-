        "jsCode": "\nconst { csvText, dateLabel } = $input.first().json;\n\nfunction parseCSV(text) {\n  const rows = []; let i = 0;\n  while (i < text.length) {\n    const row = [];\n    while (i < text.length) {\n      let v = '';\n      if (text[i] === '\"') {\n        i++;\n        while (i < text.length) {\n          if (text[i] === '\"') { if (text[i+1] === '\"') { v += '\"'; i += 2; } else { i++; break; } }\n          else { v += text[i]; i++; }\n        }\n      } else {\n        while (i < text.length && text[i] !== ',' && text[i] !== '\\n' && text[i] !== '\\r') { v += text[i]; i++; }\n      }\n      row.push(v);\n      if (i >= text.length || text[i] === '\\n' || text[i] === '\\r') break;\n      if (text[i] === ',') i++;\n    }\n    if (text[i] === '\\r') i++;\n    if (text[i] === '\\n') i++;\n    if (row.length > 1 || (row.length === 1 && row[0].trim() !== '')) rows.push(row);\n  }\n  return rows;\n}\n\nconst rows = parseCSV(csvText);\nif (rows.length < 2) throw new Error('CSV has no data rows');\nconst hdr = rows[0].map(h => h.trim());\nconst ci = {};\nhdr.forEach((h, idx) => ci[h] = idx);\n\n/* Pass 1a: message_id -> singlesend mapping */\nconst msgMap = {};\nfor (let r = 1; r < rows.length; r++) {\n  const row = rows[r];\n  const mid = (row[ci['message_id']] || '').trim();\n  const ua = (row[ci['unique_args']] || '').trim();\n  if (!mid || !ua || ua === '{}') continue;\n  try {\n    const obj = JSON.parse(ua);\n    if (obj.singlesend_id) msgMap[mid] = { id: obj.singlesend_id, name: obj.singlesend_name || '' };\n  } catch(e) {}\n}\n\n/* Pass 1b: message_id -> {subject, from} from ALL rows */\nconst midMeta = {};\nfor (let r = 1; r < rows.length; r++) {\n  const row = rows[r];\n  const mid = (row[ci['message_id']] || '').trim();\n  if (!mid) continue;\n  const subj = (row[ci['subject']] || '').trim();\n  const frm = (row[ci['from']] || '').trim();\n  if (!midMeta[mid]) midMeta[mid] = {};\n  if (subj && !midMeta[mid].subject) midMeta[mid].subject = subj;\n  if (frm && !midMeta[mid].from) midMeta[mid].from = frm;\n}\n\n/* Pass 2: assign rows — get singlesend_name, extract client prefix, group by prefix */\nconst clientGroups = {};\nconst headerLine = hdr.join(',');\n\nfor (let r = 1; r < rows.length; r++) {\n  const row = rows[r];\n  const mid = (row[ci['message_id']] || '').trim();\n  let ssName = '';\n\n  /* Get singlesend_name for this row */\n  const ua = (row[ci['unique_args']] || '').trim();\n  if (ua && ua !== '{}') {\n    try {\n      const obj = JSON.parse(ua);\n      if (obj.singlesend_name) ssName = obj.singlesend_name;\n      if (!obj.singlesend_id && !(mid && msgMap[mid])) continue; /* no singlesend = warmup, skip */\n      if (!ssName && obj.singlesend_id && msgMap[mid]) ssName = msgMap[mid].name;\n    } catch(e) {}\n  }\n  if (!ssName && mid && msgMap[mid]) ssName = msgMap[mid].name;\n  if (!ssName) continue; /* warmup — skip */\n\n  /* Extract client prefix: text before the first \" - \" */\n  const dashIdx = ssName.indexOf(' - ');\n  const clientId = dashIdx > 0 ? ssName.substring(0, dashIdx).trim() : ssName.trim();\n\n  if (!clientGroups[clientId]) {\n    clientGroups[clientId] = { name: clientId, ssNames: new Set(), rows: [] };\n  }\n  clientGroups[clientId].ssNames.add(ssName);\n  clientGroups[clientId].rows.push(row);\n}\n\n/* Build output: one item per client group */\nconst results = [];\nfor (const [clientId, group] of Object.entries(clientGroups)) {\n  /* Build campaign name from client prefix + count of singlesend_ids */\n  const ssCount = group.ssNames.size;\n  const campaignName = clientId + ' (' + ssCount + ' campaigns)';\n\n  const cleanName = clientId\n    .replace(/[\\\\/:*?\"<>|']/g, '')\n    .replace(/[\\s]+/g, '_')\n    .replace(/_+/g, '_')\n    .replace(/^_|_$/g, '')\n    .substring(0, 60);\n  const fileName = 'SendGrid_Report_' + cleanName + '.xlsx';\n\n  /* Serialize CSV with subject/from enriched */\n  const csvLines = [headerLine];\n  for (const row of group.rows) {\n    const mid = (row[ci['message_id']] || '').trim();\n    const meta = midMeta[mid] || {};\n    const enriched = [...row];\n    if (ci['subject'] !== undefined && !enriched[ci['subject']].trim() && meta.subject) enriched[ci['subject']] = meta.subject;\n    if (ci['from'] !== undefined && !enriched[ci['from']].trim() && meta.from) enriched[ci['from']] = meta.from;\n    csvLines.push(enriched.map(c => {\n      if (c.includes(',') || c.includes('\"') || c.includes('\\n')) return '\"' + c.replace(/\"/g, '\"\"') + '\"';\n      return c;\n    }).join(','));\n  }\n\n  results.push({\n    json: {\n      singlesendId: clientId,\n      campaignName: campaignName,\n      xlsxFile: fileName,\n      csvContent: csvLines.join('\\n'),\n      rows: group.rows.length,\n      dateLabel,\n      singlesendCount: ssCount,\n      singlesendNames: [...group.ssNames]\n    }\n  });\n}\n\nif (results.length === 0) throw new Error('No campaigns found — all rows may be warmup emails');\nreturn results;\n"
