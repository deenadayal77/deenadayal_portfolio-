        "jsCode": "\nconst reportItems = $('Generate Excel Report').all();\nconst driveItems = $('Upload Files').all();\n\nconst linkMap = {};\nfor (const d of driveItems) {\n  const name = d.json.name || '';\n  const id = d.json.id || '';\n  if (id) linkMap[name] = 'https://drive.google.com/file/d/' + id + '/view';\n}\n\nconst folderId = $('Create Folder').first().json.id || '';\nconst folderLink = folderId ? 'https://drive.google.com/drive/folders/' + folderId : '';\nconst dateLabel = reportItems[0].json.dateLabel || '';\n\nlet html = '<div style=\"font-family:Calibri,Arial,sans-serif;font-size:14px;color:#333;\">';\nhtml += '<h2 style=\"color:#4472C4;margin-bottom:5px;\">SendGrid Campaign Reports \\u2014 ' + dateLabel + '</h2>';\nhtml += '<p style=\"margin-top:0;\">' + reportItems.length + ' campaign reports generated and uploaded to Google Drive.</p>';\nif (folderLink) html += '<p><strong>\\ud83d\\udcc2 Drive Folder:</strong> <a href=\"' + folderLink + '\" style=\"color:#4472C4;\">' + folderLink + '</a></p>';\n\nhtml += '<table style=\"border-collapse:collapse;font-size:12px;margin-top:10px;width:100%;\">';\nhtml += '<tr style=\"background:#4472C4;color:#fff;\"><th style=\"padding:6px 10px;border:1px solid #ddd;text-align:left;\">#</th><th style=\"padding:6px 10px;border:1px solid #ddd;text-align:left;\">Campaign</th><th style=\"padding:6px 10px;border:1px solid #ddd;\">Del</th><th style=\"padding:6px 10px;border:1px solid #ddd;\">U.Opens</th><th style=\"padding:6px 10px;border:1px solid #ddd;\">OR%</th><th style=\"padding:6px 10px;border:1px solid #ddd;\">U.Clicks</th><th style=\"padding:6px 10px;border:1px solid #ddd;\">CTR%</th><th style=\"padding:6px 10px;border:1px solid #ddd;\">CTOR%</th></tr>';\n\nreportItems.forEach((it, i) => {\n  const j = it.json;\n  const bg = i % 2 === 0 ? '#fff' : '#f7f7f7';\n  const url = linkMap[j.xlsxFile] || '';\n  const nameCell = url ? '<a href=\"'+url+'\" style=\"color:#4472C4;text-decoration:none;\">'+j.campaignName+'</a>' : j.campaignName;\n  html += '<tr style=\"background:'+bg+';\"><td style=\"padding:4px 10px;border:1px solid #eee;\">'+(i+1)+'</td><td style=\"padding:4px 10px;border:1px solid #eee;\">'+nameCell+'</td><td style=\"padding:4px 10px;border:1px solid #eee;text-align:center;\">'+j.delivered+'</td><td style=\"padding:4px 10px;border:1px solid #eee;text-align:center;\">'+j.uniqueOpens+'</td><td style=\"padding:4px 10px;border:1px solid #eee;text-align:center;\">'+j.openRate+'%</td><td style=\"padding:4px 10px;border:1px solid #eee;text-align:center;\">'+j.uniqueClicks+'</td><td style=\"padding:4px 10px;border:1px solid #eee;text-align:center;\">'+j.ctr+'%</td><td style=\"padding:4px 10px;border:1px solid #eee;text-align:center;\">'+j.ctor+'%</td></tr>';\n});\nhtml += '</table>';\nhtml += '<p style=\"font-size:11px;color:#888;margin-top:15px;\">Each Excel contains 13 sheets + 5 charts. Bot detection: honeypot (youtube.com) OR open/click \\u226460s after delivery.</p></div>';\n\nreturn [{ json: { dateLabel, emailHtml: html, count: reportItems.length } }];\n"
